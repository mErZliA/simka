# ---------- Telegram (my.telegram.org -> API development tools) ----------
API_ID=22222523
API_HASH=8fc05d9d19bc7548bc6ab83770eaeb80
BOT_TOKEN=8617335119:AAG8nJ2WJqBvKhIPgWp0CIcvErihDhjEzJ0

# ---------- Игра ----------
# Канал, на который должен быть подписан игрок
CHANNEL=@ItzSimRoulette

# Публичный HTTPS-адрес WebApp (Telegram не принимает http:// и IP).
# Текущий trycloudflare-туннель одноразовый — замени на свой домен,
# например https://sim-roulette.example.com (Caddy/nginx -> 127.0.0.1:8080).
WEBAPP_URL=https://baby-farm-safe-server.trycloudflare.com

PORT=8080
WEBAPP_DIR=./webapp

# ---------- Админы (Telegram user ID через запятую) ----------
ADMIN_IDS=6488542512,1581658045

# ---------- Режим ----------
# 1 — можно заходить по uid без initData (только для локальных тестов!)
# 0 — ОБЯЗАТЕЛЬНО для прода: вход только по подписанному initData
DEV_MODE=1

# ---------- Прокси (SOCKS5) ----------
