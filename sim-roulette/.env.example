# ==========================================================
#  SIM Roulette — шаблон конфига
#  cp .env.example .env  и заполни своими значениями
# ==========================================================

# ---------- Telegram ----------
API_ID=12345678
API_HASH=00000000000000000000000000000000
BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample

# ---------- Игра ----------
CHANNEL=@your_channel

# Публичный HTTPS-адрес WebApp (Telegram не принимает http:// и IP)
WEBAPP_URL=https://your-domain.example.com

PORT=8080
WEBAPP_DIR=./webapp

# ---------- Админы (Telegram user ID через запятую) ----------
ADMIN_IDS=111111111,222222222

# ---------- Режим ----------
# 1 — тесты вне Telegram, 0 — прод
DEV_MODE=1

# ---------- Прокси (SOCKS5) ----------
# Значения по умолчанию — в bot/config.py; здесь можно переопределить
# PROXY_ENABLED=1
# PROXY_ADDR=127.0.0.1
# PROXY_PORT=1080
# PROXY_USER=user
# PROXY_PASS=pass
