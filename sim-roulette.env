# ==========================================================
#  SIM Roulette — рабочий конфиг (.env)
#  Формат: LF, UTF-8, без кавычек, без пробелов вокруг "="
# ==========================================================

# ---------- Telegram (my.telegram.org -> API development tools) ----------
API_ID=220432916
API_HASH=c3dadd7fd0b87e02b338c0dfe5947ffb
BOT_TOKEN=8617335119:AAG8nJ2WJqBvKhIPgWp0CIcvErihDhjEzJ0

# ---------- Игра ----------
# Канал, на который должен быть подписан игрок
CHANNEL=@sim_roulette

# Публичный HTTPS-адрес WebApp (Telegram не принимает http:// и IP).
# Домен нужно привязать у владельца бота в @BotFather (/setmenubutton, /newapp).
WEBAPP_URL=https://simroulette.online/

PORT=8080
WEBAPP_DIR=./webapp

# ---------- Админы (Telegram user ID через запятую, без пробелов) ----------
ADMIN_IDS=1432191991,1581658045

# ---------- Режим ----------
# 1 — можно заходить по uid без initData (только для локальных тестов!)
# 0 — ОБЯЗАТЕЛЬНО для прода: вход только по подписанному initData
DEV_MODE=1

# ---------- Прокси (SOCKS5) ----------
# Боевой прокси. Те же значения зашиты дефолтами в bot/config.py,
# здесь они активны, чтобы конфиг был самодостаточным.
# Отключить прокси целиком: PROXY_ENABLED=0
PROXY_ENABLED=1
PROXY_ADDR=178.208.87.21
PROXY_PORT=1080
PROXY_USER=revolution
PROXY_PASS=fZESz14Ay5GS
PROXY_RDNS=1
