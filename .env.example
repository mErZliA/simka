API_ID=0
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token
CHANNEL=@simroulette_news
WEBAPP_URL=https://your-domain.example/
PORT=8080
WEBAPP_DIR=./webapp
ADMIN_IDS=123456789
# По умолчанию безопасный production-режим. Для локального теста явно задать
# APP_ENV=development и DEV_MODE=1; оба параметра обязательны.
APP_ENV=production
DEV_MODE=0
INITDATA_MAX_AGE=86400
INITDATA_FUTURE_SKEW=60
DB_PATH=./simroulette.db
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
# Публичный источник справочных валютных курсов (без API-ключа)
FX_API_URL=https://open.er-api.com/v6/latest/RUB
# Автопостить в канал при старте/стопе техперерыва (1/0)
MAINTENANCE_NOTIFY=1
LOG_FILE=./logs/simroulette.log
